
IDENTIFICATION DIVISION.
PROGRAM-ID. CREATE-INPUT.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.

    SELECT CUST-MASTER
        ASSIGN TO "CUST-MASTER"
        ORGANIZATION IS INDEXED
        ACCESS MODE IS SEQUENTIAL
        RECORD KEY IS CUST-ID
        FILE STATUS IS WS-MASTER-STATUS.

    SELECT PURGE-INPUT
        ASSIGN TO "Input.txt"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-INPUT-FILE-STATUS.

DATA DIVISION.
FILE SECTION.

FD CUST-MASTER.
01 CUST-MASTER-RECORD.
   05 CUST-ID PIC X(12).
   05 CUST-NAME       PIC X(25).
   05 CUST-STATUS     PIC X(6).

FD PURGE-INPUT.
01 PURGE-INPUT-RECORD PIC X(100).

WORKING-STORAGE SECTION.
01 WS-MASTER-STATUS      PIC XX.
01 WS-INPUT-FILE-STATUS  PIC XX.
01 WS-INPUT-ID           PIC X(12).
01 WS-INPUT-NAME         PIC X(25).
01 WS-INPUT-STATUS       PIC X(6).
01 WS-INPUT-LINE         PIC X(100).

01 WS-EOF                PIC X VALUE 'N'.
01 WS-INVALID-FLAG       PIC X VALUE 'N'.
01 WS-FIELD-COUNT        PIC 9 VALUE ZERO.

01 WS-TOTAL-COUNT        PIC 9(5) VALUE ZERO.
01 WS-CREATE-COUNT       PIC 9(5) VALUE ZERO.
01 WS-DUPLICATE-COUNT    PIC 9(5) VALUE ZERO.
01 WS-ERROR-COUNT        PIC 9(5) VALUE ZERO.

PROCEDURE DIVISION.
    OPEN INPUT PURGE-INPUT

    IF WS-INPUT-FILE-STATUS NOT = '00'
        DISPLAY 'ERROR OPENING INPUT FILE'
        DISPLAY 'FILE STATUS: ' WS-INPUT-FILE-STATUS
        STOP RUN
    END-IF

    OPEN OUTPUT CUST-MASTER

    IF WS-MASTER-STATUS NOT = '00'
        DISPLAY 'ERROR CREATING CUSTOMER MASTER'
        DISPLAY 'FILE STATUS: ' WS-MASTER-STATUS

        CLOSE PURGE-INPUT
        STOP RUN
    END-IF

    PERFORM UNTIL WS-EOF = 'Y'

        READ PURGE-INPUT
            AT END
                MOVE 'Y' TO WS-EOF

            NOT AT END
                ADD 1 TO WS-TOTAL-COUNT
                PERFORM PROCESS-CUSTOMER

        END-READ

    END-PERFORM

    CLOSE PURGE-INPUT
    CLOSE CUST-MASTER

    DISPLAY 'TOTAL INPUT RECORDS : '
            WS-TOTAL-COUNT

    DISPLAY 'RECORDS CREATED     : '
            WS-CREATE-COUNT

    DISPLAY 'DUPLICATE RECORDS   : '
            WS-DUPLICATE-COUNT

    DISPLAY 'OTHER ERRORS        : '
            WS-ERROR-COUNT

    STOP RUN.


PROCESS-CUSTOMER.

    MOVE SPACES TO WS-INPUT-ID WS-INPUT-NAME WS-INPUT-STATUS WS-INPUT-LINE

    MOVE 'N' TO WS-INVALID-FLAG
    MOVE ZERO TO WS-FIELD-COUNT

    MOVE PURGE-INPUT-RECORD TO WS-INPUT-LINE

    UNSTRING WS-INPUT-LINE
        DELIMITED BY '|'
        INTO WS-INPUT-ID
             WS-INPUT-NAME
             WS-INPUT-STATUS
        TALLYING IN WS-FIELD-COUNT
        ON OVERFLOW
            MOVE 'Y' TO WS-INVALID-FLAG
    END-UNSTRING

    IF WS-INVALID-FLAG = 'Y' OR WS-FIELD-COUNT NOT = 3 OR WS-INPUT-ID = SPACES OR WS-INPUT-NAME = SPACES OR WS-INPUT-STATUS = SPACES
        DISPLAY 'INVALID INPUT RECORD'
        DISPLAY 'INPUT: ' WS-INPUT-LINE
        ADD 1 TO WS-ERROR-COUNT
    
    ELSE
        MOVE WS-INPUT-ID TO CUST-ID
        MOVE WS-INPUT-NAME TO CUST-NAME
        MOVE WS-INPUT-STATUS TO CUST-STATUS

        ADD 1 TO WS-CREATE-COUNT

        WRITE CUST-MASTER-RECORD
        END-WRITE

        EVALUATE WS-MASTER-STATUS
            WHEN '00'
                CONTINUE

            WHEN '22'
                DISPLAY 'CREATE RESULT : DUPLICATE KEY'
                ADD 1 TO WS-DUPLICATE-COUNT

            WHEN OTHER
                DISPLAY 'CREATE RESULT : ERROR'
                DISPLAY 'FILE STATUS   : '
                        WS-MASTER-STATUS

                ADD 1 TO WS-ERROR-COUNT

        END-EVALUATE

    END-IF.
