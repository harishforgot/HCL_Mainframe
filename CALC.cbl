IDENTIFICATION DIVISION.
PROGRAM-ID. calc.

DATA DIVISION.
WORKING-STORAGE SECTION.

77 CHO PIC 9 VALUE 0.
77 A PIC S9(5).
77 B PIC S9(5).
01 RESULT.
    05 D PIC -(9)9.
    05 F PIC -(4)9.99.

PROCEDURE DIVISION.

PERFORM UNTIL CHO = 5
    DISPLAY '1. ADDITION'
    DISPLAY '2. SUBTRACTION'
    DISPLAY '3. MULTIPLICATION'
    DISPLAY '4. DIVISION'
    DISPLAY '5. EXIT'
    DISPLAY 'ENTER YOUR CHOICE: ' WITH NO ADVANCING
    ACCEPT CHO

    IF (CHO > 0) AND (CHO < 5)
    DISPLAY 'ENTER YOUR FIRST NUM: ' WITH NO ADVANCING
    ACCEPT A
    DISPLAY 'ENTER YOUR SECOND NUM: ' WITH NO ADVANCING
    ACCEPT B
    END-IF

    EVALUATE CHO

    WHEN 1
        ADD A TO B GIVING D IN RESULT
        DISPLAY 'SUM = ' FUNCTION TRIM(D IN RESULT)
    WHEN 2
        SUBTRACT B FROM A GIVING D IN RESULT
        DISPLAY 'DIFFERENCE = ' FUNCTION TRIM(D IN RESULT)
    WHEN 3
        MULTIPLY A BY B GIVING D IN RESULT
        DISPLAY 'RESULT = ' FUNCTION TRIM(D IN RESULT)
    WHEN 4
        IF B = 0
            DISPLAY 'ERROR: DIVISOR CANNOT BE ZERO'
        ELSE
            DIVIDE A BY B GIVING F IN RESULT REMAINDER D IN RESULT
            DISPLAY 'RESULT = ' FUNCTION TRIM(F IN RESULT)
    WHEN 5
        DISPLAY 'EXITING...'
    WHEN OTHER
        DISPLAY 'INVALID CHOICE'
    END-EVALUATE
END-PERFORM
STOP RUN.
