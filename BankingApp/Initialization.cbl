IDENTIFICATION DIVISION.
PROGRAM-ID. INITIALIZATION.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.

    SELECT ACCOUNT-DETAILS
        ASSIGN TO 'BankingApp/Files/ACCOUNT-DETAILS'
        ORGANIZATION IS INDEXED
        ACCESS MODE IS RANDOM
        RECORD KEY IS ACCOUNT-NO
        FILE STATUS IS WS-FILE-STATUS.

    SELECT INPUT-DETAILS
        ASSIGN TO 'BankingApp/Files/Input.txt'
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-INPUT-STATUS.

DATA DIVISION.
FILE SECTION.

    FD ACCOUNT-DETAILS.
    01 ACCOUNT-DETAILS-RECORD.
        05 ACCOUNT-NO PIC 9(10).
        05 ACCOUNT-PIN PIC 9(4).
        05 BALANCE PIC 9(6).

    FD INPUT-DETAILS.
        01 INPUT-DETAILS-RECORD PIC 9(20).

WORKING-STORAGE SECTION.

    01 WS-FILE-STATUS PIC XX.
    01 WS-INPUT-STATUS PIC XX.
    01 WS-EOF PIC X VALUE 'N'.

    01 WS-INPUT-LINE PIC 9(20).
    01 WS-INPUT-ACCOUNT REDEFINES WS-INPUT-LINE.
        05 WS-INPUT-ACCOUNT-NO PIC 9(10).
        05 WS-INPUT-ACCOUNT-PIN PIC 9(4).
        05 WS-INPUT-BALANCE PIC 9(6).

    01 TOTAL-COUNT PIC 9(2).
    01 SUCCESS-COUNT PIC 9(2).
    01 ERROR-COUNT PIC 9(2).
    01 VALUE-COUNT PIC 9.
    

PROCEDURE DIVISION.

    OPEN INPUT INPUT-DETAILS

    IF WS-INPUT-STATUS NOT = '00'
        DISPLAY 'ERROR OPENING INPUT FILE'
        DISPLAY 'FILE STATUS: ' WS-INPUT-STATUS
        STOP RUN
    END-IF

    OPEN OUTPUT ACCOUNT-DETAILS

    IF WS-FILE-STATUS NOT = '00'
        DISPLAY 'ERROR CREATING ACCOUNT DETAILS'
        DISPLAY 'FILE STATUS: ' WS-FILE-STATUS
        CLOSE INPUT-DETAILS
        STOP RUN
    END-IF

    PERFORM UNTIL WS-EOF = 'Y'

        READ INPUT-DETAILS
        AT END
            MOVE 'Y' TO WS-EOF
            SUBTRACT 1 FROM TOTAL-COUNT ERROR-COUNT
        NOT AT END
            MOVE ZERO TO WS-INPUT-ACCOUNT VALUE-COUNT
                    
            MOVE INPUT-DETAILS-RECORD TO WS-INPUT-ACCOUNT
            ADD 1 TO TOTAL-COUNT

            IF WS-INPUT-ACCOUNT-NO = ZERO
                ADD 1 TO ERROR-COUNT

            ELSE
                MOVE WS-INPUT-ACCOUNT-NO TO ACCOUNT-NO
                MOVE WS-INPUT-ACCOUNT-PIN TO ACCOUNT-PIN
                MOVE WS-INPUT-BALANCE TO BALANCE

                WRITE ACCOUNT-DETAILS-RECORD
                END-WRITE

                IF WS-FILE-STATUS = '00'
                    ADD 1 TO SUCCESS-COUNT
                ELSE
                    DISPLAY 'ERROR ADDING RECORD'
                    DISPLAY 'FILE STATUS: ' WS-FILE-STATUS
                    ADD 1 TO ERROR-COUNT
                END-IF
            END-IF
        END-READ
    END-PERFORM

    CLOSE INPUT-DETAILS
    CLOSE ACCOUNT-DETAILS

    DISPLAY 'TOTAL RECORDS: ' TOTAL-COUNT
    DISPLAY 'SUCCESS: ' SUCCESS-COUNT
    DISPLAY 'ERROR: ' ERROR-COUNT
STOP RUN.
