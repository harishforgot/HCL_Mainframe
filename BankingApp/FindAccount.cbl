IDENTIFICATION DIVISION.
PROGRAM-ID. FINDACCOUNT.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.

    SELECT ACCOUNT-DETAILS
    ASSIGN TO 'BankingApp/Files/ACCOUNT-DETAILS'
    ORGANIZATION IS INDEXED
    ACCESS MODE IS RANDOM
    RECORD KEY IS ACCOUNT-NO
    FILE STATUS IS WS-FILE-STATUS.

DATA DIVISION.
FILE SECTION.

FD ACCOUNT-DETAILS.
    
    01 ACCOUNT-DETAILS-RECORD.
        05 ACCOUNT-NO PIC 9(10).
        05 ACCOUNT-PIN PIC 9(4).
        05 BALANCE PIC 9(6).

WORKING-STORAGE SECTION.

    01 WS-FILE-STATUS PIC XX.

    01 INPUT-ACCOUNT-NO PIC 9(10).
    01 INPUT-ACCOUNT-PIN PIC 9(4).
    
PROCEDURE DIVISION.

    OPEN INPUT ACCOUNT-DETAILS.

    IF WS-FILE-STATUS NOT = '00'
        DISPLAY 'ERROR OPENING ACCOUNT DETAILS'
        DISPLAY 'FILE STATUS: ' WS-FILE-STATUS
        STOP RUN
    END-IF

    DISPLAY 'ENTER ACCOUNT NO. TO SEARCH: ' WITH NO ADVANCING
    ACCEPT INPUT-ACCOUNT-NO

    MOVE INPUT-ACCOUNT-NO TO ACCOUNT-NO

    READ ACCOUNT-DETAILS KEY IS ACCOUNT-NO
    INVALID KEY
        DISPLAY 'ACCOUNT NOT FOUND'
    NOT INVALID KEY
        DISPLAY 'ENTER PIN: ' WITH NO ADVANCING
        ACCEPT INPUT-ACCOUNT-PIN

        IF INPUT-ACCOUNT-PIN = ACCOUNT-PIN
            DISPLAY 'ACCOUNT NO.: ' ACCOUNT-NO
            DISPLAY 'BALANCE: ' BALANCE
        ELSE
            DISPLAY 'INCORRECT PIN'
        END-IF
    END-READ
    CLOSE ACCOUNT-DETAILS
STOP RUN.
