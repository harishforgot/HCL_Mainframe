IDENTIFICATION DIVISION.
PROGRAM-ID. ADDACCOUNTS.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.

    SELECT ACCOUNT-DETAILS
    ASSIGN TO 'BankingApp/Files/ACCOUNT-DETAILS'
    ORGANIZATION IS INDEXED
    ACCESS MODE IS RANDOM
    RECORD KEY IS ACCOUNT-NO
    FILE STATUS IS WS-FILE-STATUS.

DATA DIVISION.
FILE SECTION.

    FD ACCOUNT-DETAILS.
    01 ACCOUNT-DETAILS-RECORD.
        05 ACCOUNT-NO PIC 9(10).
        05 ACCOUNT-PIN PIC 9(4).
        05 BALANCE PIC 9(6).

WORKING-STORAGE SECTION.

    01 WS-FILE-STATUS PIC XX.
    
    01 N PIC 99.
    01 I PIC 99.

    01 INPUT-ACCOUNT-NO PIC 9(10).
    01 INPUT-ACCOUNT-PIN PIC 9(4).
    01 INPUT-BALANCE PIC 9(6).

PROCEDURE DIVISION.

    OPEN I-O ACCOUNT-DETAILS

    IF WS-FILE-STATUS NOT = '00'
        DISPLAY 'ERROR OPENING ACCOUNT DETAILS'
        DISPLAY 'FILE STATUS: ' WS-FILE-STATUS
        STOP RUN
    END-IF

    DISPLAY 'ENTER NO. OF ACCOUNTS TO ADD: ' WITH NO ADVANCING
    ACCEPT N

    PERFORM VARYING I FROM 1 BY 1 UNTIL I > N

        MOVE ZERO TO INPUT-ACCOUNT-NO INPUT-ACCOUNT-PIN INPUT-BALANCE

        DISPLAY 'ENTER ACCOUNT ' I ' NO: ' WITH NO ADVANCING
        ACCEPT INPUT-ACCOUNT-NO

        DISPLAY 'ENTER ACCOUNT ' I ' PIN: ' WITH NO ADVANCING
        ACCEPT INPUT-ACCOUNT-PIN

        DISPLAY 'ENTER ACCOUNT ' I ' BALANCE: ' WITH NO ADVANCING
        ACCEPT INPUT-BALANCE

        IF INPUT-ACCOUNT-NO = ZERO
            DISPLAY 'ERROR: ACCOUNT NUMBER CANNOT BE ZERO'
        ELSE

            MOVE INPUT-ACCOUNT-NO TO ACCOUNT-NO
            MOVE INPUT-ACCOUNT-PIN TO ACCOUNT-PIN
            MOVE INPUT-BALANCE TO BALANCE

            WRITE ACCOUNT-DETAILS-RECORD
            END-WRITE

            IF WS-FILE-STATUS NOT = '00'
                DISPLAY 'ERROR WRITING THE RECORD'
                DISPLAY 'FILE STATUS: ' WS-FILE-STATUS
            ELSE
                DISPLAY 'SUCCESSFULLY WRITTEN RECORD'
            END-IF
        END-IF

    END-PERFORM

    CLOSE ACCOUNT-DETAILS

STOP RUN.
