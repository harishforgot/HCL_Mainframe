IDENTIFICATION DIVISION.
PROGRAM-ID. MAIN.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.

    SELECT ACCOUNT-DETAILS
    ASSIGN TO 'BankingApp/Files/ACCOUNT-DETAILS'
    ORGANIZATION IS INDEXED
    ACCESS MODE IS RANDOM
    RECORD KEY IS ACCOUNT-NO
    FILE STATUS IS WS-FILE-STATUS.

DATA DIVISION.
FILE SECTION.

FD ACCOUNT-DETAILS.
    
    01 ACCOUNT-DETAILS-RECORD.
        05 ACCOUNT-NO PIC 9(10).
        05 ACCOUNT-PIN PIC 9(4).
        05 BALANCE PIC 9(6).

WORKING-STORAGE SECTION.

    01 WS-FILE-STATUS PIC XX.
    01 WS-EOF PIC X VALUE 'N'.

    01 A-ACCOUNT-NO PIC 9(10) VALUE ZERO.
    01 A-ACCOUNT-PIN PIC 9(4).
    01 A-BALANCE PIC 9(6).

    01 B-ACCOUNT-NO PIC 9(10).
    01 B-BALANCE PIC 9(6).

    01 T-VALUE PIC 9(6).

    01 C PIC 9 VALUE 0.
    01 N PIC X(01) VALUE X'0A'.

PROCEDURE DIVISION.

    OPEN I-O ACCOUNT-DETAILS

    IF WS-FILE-STATUS NOT = '00'
        DISPLAY 'ERROR: UNABLE TO CONNECT TO SERVER'
        DISPLAY 'ERROR CODE: ' WS-FILE-STATUS
        STOP RUN
    END-IF

    PERFORM UNTIL C = 7

        DISPLAY N 'MENU' N '1. LOG IN' N '2. LOG OUT' N '3. CHECK BALANCE' N '4. DEPOSIT MONEY' N '5. WITHDRAW MONEY' N '6. TRANSFER MONEY' N '7. EXIT' N 'ENTER YOUR CHOICE: ' WITH NO ADVANCING
        ACCEPT C

        EVALUATE C
        
        WHEN 1
            PERFORM LOG-IN
        WHEN 2
            PERFORM LOG-OUT
        WHEN 3
            PERFORM CHECK-BALANCE
        WHEN 4
            PERFORM DEPOSIT-MONEY
        WHEN 5
            PERFORM WITHDRAW-MONEY
        WHEN 6
            PERFORM TRANSFER-MONEY
        WHEN 7
            DISPLAY 'THANK YOU'
        WHEN OTHER
            DISPLAY 'ERROR: INVALID OPTION'
        END-EVALUATE

    END-PERFORM

    CLOSE ACCOUNT-DETAILS

STOP RUN.

UPDATE-ACCOUNT-DETAILS.

    READ ACCOUNT-DETAILS KEY IS ACCOUNT-NO
    INVALID KEY
        DISPLAY 'ERROR: ACCOUNT NOT FOUND - PLEASE LOG IN AGAIN'
        MOVE ZERO TO A-ACCOUNT-NO A-ACCOUNT-PIN A-BALANCE ACCOUNT-DETAILS-RECORD
    NOT INVALID KEY
        CONTINUE
    END-READ.

LOG-IN.

    IF A-ACCOUNT-NO = ZERO
        MOVE ZERO TO A-ACCOUNT-PIN A-BALANCE ACCOUNT-DETAILS-RECORD

        DISPLAY 'ENTER YOUR ACCOUNT NO.: ' WITH NO ADVANCING
        ACCEPT A-ACCOUNT-NO
        MOVE A-ACCOUNT-NO TO ACCOUNT-NO

        PERFORM UPDATE-ACCOUNT-DETAILS

        IF ACCOUNT-NO NOT = ZERO

            DISPLAY 'ENTER YOUR SECURITY PIN: ' WITH NO ADVANCING
            ACCEPT A-ACCOUNT-PIN

            IF A-ACCOUNT-PIN = ACCOUNT-PIN
                DISPLAY 'LOGGED IN'
            ELSE
                DISPLAY 'ERROR: INCORRECT PIN'
                MOVE ZERO TO A-ACCOUNT-NO A-ACCOUNT-PIN A-BALANCE ACCOUNT-DETAILS-RECORD
            END-IF
        END-IF
    ELSE
        DISPLAY 'ERROR: PLEASE LOG OUT BEFORE LOGGING IN AGAIN.'
    END-IF.

LOG-OUT.
    
    IF A-ACCOUNT-NO NOT = ZERO
        MOVE ZERO TO A-ACCOUNT-NO A-ACCOUNT-PIN A-BALANCE ACCOUNT-DETAILS-RECORD
        DISPLAY 'LOGGED OUT'
    ELSE
        DISPLAY 'ERROR: NOT LOGGED IN'
    END-IF.

CHECK-BALANCE.
    
    IF A-ACCOUNT-NO = ZERO
        DISPLAY 'ERROR: PLEASE LOG IN BEFORE CHECKING BALANCE'

    ELSE
        DISPLAY 'ENTER YOUR SECURITY PIN: ' WITH NO ADVANCING
        ACCEPT A-ACCOUNT-PIN
        
        PERFORM UPDATE-ACCOUNT-DETAILS

        IF A-ACCOUNT-PIN = ACCOUNT-PIN
            DISPLAY 'ACCOUNT NO.: ' ACCOUNT-NO N 'BALANCE: ' BALANCE 
        ELSE
            DISPLAY 'INCORRECT PIN'
        END-IF
    END-IF.

DEPOSIT-MONEY.

    IF A-ACCOUNT-NO = ZERO
        DISPLAY 'ERROR: PLEASE LOG IN BEFORE DEPOSITING MONEY'
    ELSE
        DISPLAY 'ENTER AMOUNT TO DEPOSIT: ' WITH NO ADVANCING
        ACCEPT T-VALUE
        DISPLAY 'ENTER YOUR SECURITY PIN: ' WITH NO ADVANCING
        ACCEPT A-ACCOUNT-PIN

        PERFORM UPDATE-ACCOUNT-DETAILS

        EVALUATE TRUE

        WHEN ACCOUNT-PIN NOT = A-ACCOUNT-PIN
            DISPLAY 'ERROR: INCORRECT PIN'
        
        WHEN T-VALUE <= 0
            DISPLAY 'ERROR: CANNOT DEPOSIT LESS THAN 1'

        WHEN (T-VALUE + BALANCE) > 999999
            DISPLAY 'ERROR: TRANSACTION FAILED - EXCEEDS ACCOUNT LIMIT'
        
        WHEN OTHER
            ADD T-VALUE TO BALANCE
            REWRITE ACCOUNT-DETAILS-RECORD
            DISPLAY 'TRANSACTION SUCCESSFUL: DEPOSITED ' T-VALUE
        END-EVALUATE

    END-IF.

WITHDRAW-MONEY.

    IF A-ACCOUNT-NO = ZERO
        DISPLAY 'ERROR: PLEASE LOG IN BEFORE WITHDRAWING MONEY'
    ELSE
        DISPLAY 'ENTER AMOUNT TO WITHDRAW: ' WITH NO ADVANCING
        ACCEPT T-VALUE
        DISPLAY 'ENTER YOUR SECURITY PIN: ' WITH NO ADVANCING
        ACCEPT A-ACCOUNT-PIN

        PERFORM UPDATE-ACCOUNT-DETAILS

        EVALUATE TRUE

        WHEN ACCOUNT-PIN NOT = A-ACCOUNT-PIN
            DISPLAY 'ERROR: INCORRECT PIN'
        
        WHEN T-VALUE <= 0
            DISPLAY 'ERROR: CANNOT WITHDRAW LESS THAN 1'

        WHEN (BALANCE - T-VALUE) < 0
            DISPLAY 'ERROR: TRANSACTION FAILED - INSUFFICIENT BALANCE'
        
        WHEN OTHER
            SUBTRACT T-VALUE FROM BALANCE
            REWRITE ACCOUNT-DETAILS-RECORD
            DISPLAY 'TRANSACTION SUCCESSFUL: WITHDRAWN ' T-VALUE
        END-EVALUATE

    END-IF.

TRANSFER-MONEY.

    IF A-ACCOUNT-NO = ZERO
        DISPLAY 'ERROR: PLEASE LOG IN BEFORE TRANSFERRING MONEY'
    ELSE

        DISPLAY 'ENTER YOUR SECURITY PIN: ' WITH NO ADVANCING
        ACCEPT A-ACCOUNT-PIN

        PERFORM UPDATE-ACCOUNT-DETAILS

        IF A-ACCOUNT-PIN = ACCOUNT-PIN

            DISPLAY 'ENTER RECEIVER ACCOUNT NO.: ' WITH NO ADVANCING
            ACCEPT B-ACCOUNT-NO
            DISPLAY 'ENTER AMOUNT TO TRANSFER: ' WITH NO ADVANCING
            ACCEPT T-VALUE

            PERFORM UPDATE-ACCOUNT-DETAILS

            MOVE BALANCE TO A-BALANCE
            MOVE B-ACCOUNT-NO TO ACCOUNT-NO

            READ ACCOUNT-DETAILS KEY IS ACCOUNT-NO
            INVALID KEY
                DISPLAY 'ACCOUNT NOT FOUND'
            NOT INVALID KEY
                MOVE BALANCE TO B-BALANCE

                EVALUATE TRUE
                WHEN T-VALUE <= 0
                    DISPLAY 'ERROR: TRANSFER AMOUNT CANNOT BE LESS THAN 1'
                WHEN (A-BALANCE - T-VALUE) < 0
                    DISPLAY 'ERROR: INSUFFICIENT BALANCE'
                WHEN (B-BALANCE + T-VALUE) > 999999
                    DISPLAY 'ERROR: RECEIVER ACCOUNT BALANCE EXCEEDS LIMIT'
                WHEN OTHER
                    ADD T-VALUE TO B-BALANCE
                    SUBTRACT T-VALUE FROM A-BALANCE

                    MOVE B-BALANCE TO BALANCE
                    REWRITE ACCOUNT-DETAILS-RECORD

                    MOVE A-ACCOUNT-NO TO ACCOUNT-NO
                    MOVE A-ACCOUNT-PIN TO ACCOUNT-PIN
                    MOVE A-BALANCE TO BALANCE
                    REWRITE ACCOUNT-DETAILS-RECORD

                    DISPLAY 'TRANSACTION SUCCESSFUL'
                END-EVALUATE

            END-READ
            MOVE A-ACCOUNT-NO TO ACCOUNT-NO
            PERFORM UPDATE-ACCOUNT-DETAILS
            MOVE ZERO TO B-ACCOUNT-NO B-BALANCE
        ELSE 
        DISPLAY 'ERROR: INCORRECT PIN'
        END-IF
    END-IF.
